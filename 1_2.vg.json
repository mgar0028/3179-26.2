{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "params": [{
        "name":"year_slider",
        "value":2006,
        "bind": {
            "input": "range",
            "min": 2006,
            "max": 2025,
            "step": 1,
            "name": "Year: "
        }
    }],
    "hconcat": [
        {
            "title": {"text": "Import Values World Map", "align": "center", "fontSize":28},
            "width":600,
            "height":300,
            "projection": {"type":"equalEarth", "rotate":[-134,0,0]},
            "layer": [{
                "data": {
                    "url": "ne_110m.json",
                    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                },
                "mark": {"type":"geoshape", "fill":"lightgray", "stroke":"white"}
            }, {
                "data": {
                    "graticule":{
                        "step": [30,30]
                    }
                },
                "mark": {"type": "geoshape", "stroke":"#ddd", "strokeDash": [10,2]}
            }, {
                "data": {"url": "data1.csv"},
                "transform": [{"filter": "datum.Year == year_slider"}],
                "mark": {
                    "type": "point",
                    "strokeWidth": 1.5
                },
                "encoding": {
                    "longitude": {"field": "Longitude", "type": "quantitative"},
                    "latitude": {"field": "Latitude", "type": "quantitative"},
                    "size": {
                        "field": "Imported Value (A$)",
                        "type": "quantitative",
                        "aggregate":"sum",
                        "scale": {"domain": [1,10000000]},
                        "legend":{"labelFontSize":14,"titleFontSize":16,"title":"Value (A$)"}
                    },
                    "color": {
                        "field":"Region",
                        "type":"nominal",
                        "legend":{"labelFontSize":14,"titleFontSize":16}
                    },
                    "tooltip": [
                        {"field":"Country", "type":"nominal"},
                        {"field":"Imported Value (A$)", "type":"quantitative", "aggregate":"sum","format":","}
                    ]
                }
            }]
        }, {
            "title": {"text": "Import Values By Region", "align": "center", "fontSize":28},
            "width":250,
            "height":250,
            "data": {"url": "data1.csv"},
            "transform": [{"filter": "datum.Year == year_slider"}],
            "mark": {"type": "arc", "innerRadius": 75},
            "encoding": {
                "theta": {"field":"Imported Value (A$)", "type":"quantitative", "aggregate":"sum"},
                "color": {"field":"Region"},
                "tooltip": [
                    {"field":"Imported Value (A$)", "type":"quantitative", "aggregate":"sum","format":","}
                ]
            }
        }
    ]
}